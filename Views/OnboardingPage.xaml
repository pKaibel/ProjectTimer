<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ProjectTimer.Views.OnboardingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ProjectTimer.ViewModels"
    x:DataType="vm:OnboardingViewModel"
    BackgroundColor="{DynamicResource Surface}">
    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Phone='24,36', Tablet='48,42', Desktop='64,48'}" Spacing="24" MaximumWidthRequest="760" HorizontalOptions="Fill">
            <Border Padding="28" BackgroundColor="{DynamicResource PrimaryContainer}" StrokeThickness="0">
                <Border.StrokeShape><RoundRectangle CornerRadius="28" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Border WidthRequest="58" HeightRequest="58" BackgroundColor="{DynamicResource Primary}" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                        <Label Text="PT" FontAttributes="Bold" FontSize="20" TextColor="{DynamicResource OnPrimary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <Label Text="{Binding Title}" Style="{StaticResource PageTitle}" TextColor="{DynamicResource OnPrimaryContainer}" />
                    <Label Text="{Binding Introduction}" FontSize="16" TextColor="{DynamicResource OnPrimaryContainer}" />
                    <Label Text="{Binding Version}" FontSize="13" TextColor="{DynamicResource OnPrimaryContainer}" Opacity="0.75" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="6">
                <Label Text="So unterstützt dich die App" Style="{StaticResource SectionTitle}" />
                <Label Text="Plane deine Arbeit projektbezogen, behalte laufende Zeiten im Blick und sichere alles bei Bedarf als CSV." Style="{StaticResource MutedLabel}" />
            </VerticalStackLayout>

            <Border Padding="20" BackgroundColor="{DynamicResource SurfaceContainer}" StrokeThickness="0">
                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                <Grid ColumnDefinitions="48,*" ColumnSpacing="16">
                    <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{DynamicResource Primary}" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <Label Text="1" FontAttributes="Bold" FontSize="18" TextColor="{DynamicResource OnPrimary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Projekte und Zeiten erfassen" FontSize="18" FontAttributes="Bold" />
                        <Label Text="Lege Projekte an, füge beim Start einen Kommentar hinzu und bearbeite ihn bei laufender Zeiterfassung bei Bedarf weiter. Erfasse Zeiten automatisch oder manuell; Abschnitte unter einer Minute werden nicht gespeichert." Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Padding="20" BackgroundColor="{DynamicResource SurfaceContainer}" StrokeThickness="0">
                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                <Grid ColumnDefinitions="48,*" ColumnSpacing="16">
                    <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{DynamicResource Primary}" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <Label Text="2" FontAttributes="Bold" FontSize="18" TextColor="{DynamicResource OnPrimary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Aktive Projekte schnell steuern" FontSize="18" FontAttributes="Bold" />
                        <Label Text="Markiere häufig verwendete Projekte als aktiv. Sie erscheinen als Schnellkacheln auf der Startseite – startet eines davon, wird ein anderer laufender Timer beendet." Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Padding="20" BackgroundColor="{DynamicResource SurfaceContainer}" StrokeThickness="0">
                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                <Grid ColumnDefinitions="48,*" ColumnSpacing="16">
                    <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{DynamicResource Primary}" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <Label Text="3" FontAttributes="Bold" FontSize="18" TextColor="{DynamicResource OnPrimary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Auswertungen auf einen Blick" FontSize="18" FontAttributes="Bold" />
                        <Label Text="Die Startseite zeigt die aktuelle Woche und den Status deiner aktiven Projekte. In der Übersicht vergleichst du Tag, Woche, Monat und Jahr; Wochenenden lassen sich in den Einstellungen einblenden." Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Padding="20" BackgroundColor="{DynamicResource SurfaceContainer}" StrokeThickness="0">
                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                <Grid ColumnDefinitions="48,*" ColumnSpacing="16">
                    <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{DynamicResource Primary}" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <Label Text="4" FontAttributes="Bold" FontSize="18" TextColor="{DynamicResource OnPrimary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Projekte sicher verwalten" FontSize="18" FontAttributes="Bold" />
                        <Label Text="Archiviere Projekte mit allen Zeiten und stelle sie bei Bedarf wieder her. Beim Löschen weist dich die App auf betroffene Zeiteinträge hin und bietet vorher eine kontrastreich hervorgehobene CSV-Sicherung an." Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Padding="20" BackgroundColor="{DynamicResource SurfaceContainer}" StrokeThickness="0">
                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                <Grid ColumnDefinitions="48,*" ColumnSpacing="16">
                    <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{DynamicResource Primary}" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <Label Text="5" FontAttributes="Bold" FontSize="18" TextColor="{DynamicResource OnPrimary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Lokal, sicher und anpassbar" FontSize="18" FontAttributes="Bold" />
                        <Label Text="Deine Daten bleiben auf deinem Gerät. Exportiere und importiere sie als CSV, wähle ein Farbschema oder den Dunkelmodus. Laufende Zeiten werden beim Schließen der App oder beim Standby beendet." Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Button Text="Los geht's" Command="{Binding FinishCommand}" Style="{StaticResource PrimaryButton}" Margin="0,4,0,16" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
