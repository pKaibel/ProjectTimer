<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ProjectTimer.Views.OnboardingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ProjectTimer.ViewModels"
    x:DataType="vm:OnboardingViewModel"
    BackgroundColor="{DynamicResource Surface}">
    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Phone='24,36', Tablet='48,42', Desktop='64,48'}" Spacing="24" MaximumWidthRequest="760" HorizontalOptions="Fill">
            <Border Padding="28" BackgroundColor="{DynamicResource PrimaryContainer}" StrokeThickness="0">
                <Border.StrokeShape><RoundRectangle CornerRadius="28" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Border WidthRequest="58" HeightRequest="58" BackgroundColor="{DynamicResource Primary}" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                        <Label Text="PT" FontAttributes="Bold" FontSize="20" TextColor="{DynamicResource OnPrimary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <Label Text="{Binding Title}" Style="{StaticResource PageTitle}" TextColor="{DynamicResource OnPrimaryContainer}" />
                    <Label Text="{Binding Introduction}" FontSize="16" TextColor="{DynamicResource OnPrimaryContainer}" />
                    <Label Text="{Binding Version}" FontSize="13" TextColor="{DynamicResource OnPrimaryContainer}" Opacity="0.75" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="6">
                <Label Text="So unterstützt dich die App" Style="{StaticResource SectionTitle}" />
                <Label Text="Erfasse deine Arbeit projektbezogen, arbeite mit Fokuszeiten und behalte deine Zeiten im Blick." Style="{StaticResource MutedLabel}" />
            </VerticalStackLayout>

            <Border Padding="20" BackgroundColor="{DynamicResource SurfaceContainer}" StrokeThickness="0">
                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                <Grid ColumnDefinitions="48,*" ColumnSpacing="16">
                    <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{DynamicResource Primary}" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <Label Text="1" FontAttributes="Bold" FontSize="18" TextColor="{DynamicResource OnPrimary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Projekte und Zeiten erfassen" FontSize="18" FontAttributes="Bold" />
                        <Label Text="Lege Projekte an und erfasse Zeiten mit dem Timer oder manuell. Du kannst einen Kommentar hinzufügen und den Timer pausieren oder zu einem anderen Projekt wechseln. Automatisch erfasste Abschnitte unter einer Minute werden nicht gespeichert." Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Padding="20" BackgroundColor="{DynamicResource SurfaceContainer}" StrokeThickness="0">
                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                <Grid ColumnDefinitions="48,*" ColumnSpacing="16">
                    <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{DynamicResource Primary}" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <Label Text="2" FontAttributes="Bold" FontSize="18" TextColor="{DynamicResource OnPrimary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Mit Pomodoro konzentriert arbeiten" FontSize="18" FontAttributes="Bold" />
                        <Label Text="Starte Pomodoro auf der Projektseite. Nach jeder Fokuszeit und Pause erinnert dich die App an die nächste Phase, die du selbst beginnst. In den Einstellungen legst du die Dauer fest und entscheidest, ob Pausen zur Projektzeit zählen." Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Padding="20" BackgroundColor="{DynamicResource SurfaceContainer}" StrokeThickness="0">
                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                <Grid ColumnDefinitions="48,*" ColumnSpacing="16">
                    <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{DynamicResource Primary}" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <Label Text="3" FontAttributes="Bold" FontSize="18" TextColor="{DynamicResource OnPrimary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Projekte finden und schnell steuern" FontSize="18" FontAttributes="Bold" />
                        <Label Text="Suche Projekte in der Projektliste und markiere häufig verwendete Projekte als aktiv. Ihre Schnellkacheln erscheinen auf der Startseite. Startest du dort einen Timer, wird ein anderer laufender Timer beendet." Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Padding="20" BackgroundColor="{DynamicResource SurfaceContainer}" StrokeThickness="0">
                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                <Grid ColumnDefinitions="48,*" ColumnSpacing="16">
                    <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{DynamicResource Primary}" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <Label Text="4" FontAttributes="Bold" FontSize="18" TextColor="{DynamicResource OnPrimary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Zeiten auswerten" FontSize="18" FontAttributes="Bold" />
                        <Label Text="Auf der Startseite siehst du deine aktuelle Woche. In der Zeitenübersicht vergleichst du Tag, Woche, Monat und Jahr. In den Einstellungen kannst du Wochenenden auf der Startseite einblenden und die maximale tägliche Arbeitszeit für die Balken festlegen." Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Padding="20" BackgroundColor="{DynamicResource SurfaceContainer}" StrokeThickness="0">
                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                <Grid ColumnDefinitions="48,*" ColumnSpacing="16">
                    <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{DynamicResource Primary}" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <Label Text="5" FontAttributes="Bold" FontSize="18" TextColor="{DynamicResource OnPrimary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Projekte und Daten verwalten" FontSize="18" FontAttributes="Bold" />
                        <Label Text="Archiviere Projekte mit ihren Zeiten und stelle sie später wieder her. Vor dem Löschen eines Projekts kannst du eine CSV-Sicherung exportieren. Deine Daten werden lokal gespeichert und lassen sich als CSV exportieren und importieren." Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Padding="20" BackgroundColor="{DynamicResource SurfaceContainer}" StrokeThickness="0">
                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                <Grid ColumnDefinitions="48,*" ColumnSpacing="16">
                    <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{DynamicResource Primary}" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <Label Text="6" FontAttributes="Bold" FontSize="18" TextColor="{DynamicResource OnPrimary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="App anpassen" FontSize="18" FontAttributes="Bold" />
                        <Label Text="Wähle in den Einstellungen ein Farbschema und den Hell- oder Dunkelmodus. Dort kannst du auch Testdaten erstellen oder alle erfassten Daten löschen." Style="{StaticResource MutedLabel}" />
                        <Label Text="Unter Windows kannst du die App beim Minimieren in den Infobereich verschieben. Beim Schließen oder im Standby wird eine laufende Zeiterfassung beendet." Style="{StaticResource MutedLabel}" IsVisible="{OnPlatform WinUI=True, Default=False}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Button Text="Los geht's" Command="{Binding FinishCommand}" Style="{StaticResource PrimaryButton}" Margin="0,4,0,16" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
