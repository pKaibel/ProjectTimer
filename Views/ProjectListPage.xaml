<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ProjectTimer.Views.ProjectListPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ProjectTimer.ViewModels"
    xmlns:services="clr-namespace:ProjectTimer.Services"
    x:DataType="vm:ProjectListViewModel"
    Title="Zeiterfassung">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Neu" Command="{Binding AddProjectCommand}" />
        <ToolbarItem Text="Einstellungen" Command="{Binding OpenSettingsCommand}" Order="Secondary" />
        <ToolbarItem Text="Info" Command="{Binding OpenInfoCommand}" Order="Secondary" />
    </ContentPage.ToolbarItems>

    <Grid Padding="{OnIdiom Phone='20,16', Tablet='36,24', Desktop='48,28'}">
        <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy, Mode=OneWay}" MaximumWidthRequest="900" HorizontalOptions="Center" VerticalOptions="Fill">
            <ScrollView VerticalScrollBarVisibility="Always" HorizontalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="18" Margin="0,0,28,0">
                    <Border Padding="20" BackgroundColor="{DynamicResource SurfaceContainer}" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1">
                        <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="Diese Woche" FontSize="19" FontAttributes="Bold" />
                                    <Label Text="Erfasste Arbeitszeit" Style="{StaticResource MutedLabel}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding WeeklyTotalText}" TextColor="{DynamicResource Primary}" FontAttributes="Bold" VerticalOptions="Center" />
                            </Grid>
                            <VerticalStackLayout Spacing="5" BindableLayout.ItemsSource="{Binding WeeklyBars}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="services:TimeChartBar">
                                        <Grid ColumnDefinitions="38,*,Auto" ColumnSpacing="10" HeightRequest="24">
                                            <Label Text="{Binding Label}" Style="{StaticResource MutedLabel}" FontSize="13" VerticalTextAlignment="Center" />
                                            <Border Grid.Column="1" HeightRequest="11" BackgroundColor="{DynamicResource SurfaceContainerHigh}" StrokeThickness="0" VerticalOptions="Center">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                                                <Border WidthRequest="{Binding BarWidth}" HeightRequest="11" BackgroundColor="{DynamicResource Primary}" StrokeThickness="0" HorizontalOptions="Start" VerticalOptions="Center">
                                                    <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                                                </Border>
                                            </Border>
                                            <Label Grid.Column="2" Text="{Binding DurationText}" FontSize="13" FontAttributes="Bold" VerticalTextAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Button Text="Übersicht anzeigen" Command="{Binding OpenOverviewCommand}" Style="{StaticResource SecondaryButton}" HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </Border>
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding HasQuickAccessProjects}">
                        <Label Text="Aktive Projekte" FontSize="19" FontAttributes="Bold" />
                        <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start" AlignItems="Start" BindableLayout.ItemsSource="{Binding QuickAccessProjects}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ProjectListItemViewModel">
                                        <Border FlexLayout.Basis="31.8%" Margin="0,0,12,12" Padding="16" BackgroundColor="{DynamicResource SurfaceContainer}" Stroke="{DynamicResource OutlineVariant}">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsTimerActive}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryContainer}" />
                                                    <Setter Property="Stroke" Value="{DynamicResource Primary}" />
                                                    <Setter Property="StrokeThickness" Value="2" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <VerticalStackLayout Spacing="10">
                                                <Label Text="{Binding Name}" FontSize="17" FontAttributes="Bold" LineBreakMode="TailTruncation" MaxLines="2" />
                                                <Label Text="{Binding QuickAccessStatusText}" HeightRequest="20" FontSize="13" FontAttributes="Bold" VerticalTextAlignment="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsTimerActive}" Value="True">
                                                            <Setter Property="TextColor" Value="{DynamicResource Success}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsTimerInactive}" Value="True">
                                                            <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariant}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                                <Label Text="{Binding TotalDurationText, StringFormat='Gesamtzeit: {0}'}" HeightRequest="20" FontSize="13" Style="{StaticResource MutedLabel}" VerticalTextAlignment="Center" />
                                                <Label Text="{Binding CurrentDurationDisplayText}" HeightRequest="20" FontSize="13" TextColor="{DynamicResource Primary}" FontAttributes="Bold" VerticalTextAlignment="Center" />
                                                <Button Text="{Binding TimerButtonText}" Clicked="OnQuickAccessTimerClicked" Style="{StaticResource PrimaryButton}">
                                                    <Button.Triggers>
                                                        <DataTrigger TargetType="Button" Binding="{Binding IsTimerRunning}" Value="True">
                                                            <Setter Property="BackgroundColor" Value="{DynamicResource Error}" />
                                                            <Setter Property="TextColor" Value="{DynamicResource OnError}" />
                                                        </DataTrigger>
                                                    </Button.Triggers>
                                                </Button>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Text="{Binding ProjectListTitle}" Style="{StaticResource PageTitle}" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                <Label Text="Archiviert" Style="{StaticResource MutedLabel}" FontSize="13" VerticalTextAlignment="Center" />
                                <Switch IsToggled="{Binding ShowArchivedProjects, Mode=OneWay}" Toggled="OnShowArchivedProjectsToggled" />
                            </HorizontalStackLayout>
                        </Grid>
                        <Label Text="Arbeitszeit lokal und zuverlässig erfassen" Style="{StaticResource MutedLabel}" />
                        <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasError}" Margin="0,8,0,0" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Projects}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProjectListItemViewModel">
                                <Border Padding="20" Stroke="{DynamicResource OutlineVariant}" BackgroundColor="{DynamicResource SurfaceContainer}">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsTimerActive}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryContainer}" />
                                            <Setter Property="Stroke" Value="{DynamicResource Primary}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.OpenProjectCommand}" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="5">
                                        <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                        <Label Grid.Column="1" Text="{Binding TotalDurationText}" FontSize="17" FontAttributes="Bold" TextColor="{DynamicResource Primary}" VerticalTextAlignment="Center" />
                                        <VerticalStackLayout Grid.Column="2" Spacing="0" VerticalOptions="Center">
                                            <Label Text="Aktiv" FontSize="12" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" />
                                            <Switch IsToggled="{Binding IsQuickAccess, Mode=OneWay}" Toggled="OnProjectQuickAccessToggled" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                        <Label Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Description}" Style="{StaticResource MutedLabel}" IsVisible="{Binding HasDescription}" LineBreakMode="TailTruncation" MaxLines="2" />
                                        <Label Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding TimerStatusText}" TextColor="{DynamicResource Success}" FontSize="13" FontAttributes="Bold" IsVisible="{Binding IsTimerActive}" Margin="0,3,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <VerticalStackLayout Padding="20,48" Spacing="8" HorizontalOptions="Center" IsVisible="{Binding IsEmpty}">
                        <Label Text="{Binding EmptyProjectsTitle}" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding EmptyProjectsText}" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" MaximumWidthRequest="420" />
                    </VerticalStackLayout>
                    <Button Text="＋ Neues Projekt" Command="{Binding AddProjectCommand}" Margin="0,4,0,0" />
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
