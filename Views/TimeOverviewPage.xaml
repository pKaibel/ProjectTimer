<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ProjectTimer.Views.TimeOverviewPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ProjectTimer.ViewModels"
    xmlns:services="clr-namespace:ProjectTimer.Services"
    x:DataType="vm:TimeOverviewViewModel"
    Title="Zeitenübersicht">
    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Phone='20,20', Tablet='36,28', Desktop='48,32'}" Spacing="22" MaximumWidthRequest="800" HorizontalOptions="Fill">
            <VerticalStackLayout Spacing="5">
                <Label Text="Zeitenübersicht" Style="{StaticResource PageTitle}" />
                <Label Text="Vergleiche deine erfasste Arbeitszeit nach Zeitraum." Style="{StaticResource MutedLabel}" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Button Text="Tag" Command="{Binding ShowDayCommand}" Style="{StaticResource SecondaryButton}" />
                <Button Grid.Column="1" Text="Woche" Command="{Binding ShowWeekCommand}" Style="{StaticResource SecondaryButton}" />
                <Button Grid.Row="1" Text="Monat" Command="{Binding ShowMonthCommand}" Style="{StaticResource SecondaryButton}" />
                <Button Grid.Row="1" Grid.Column="1" Text="Jahr" Command="{Binding ShowYearCommand}" Style="{StaticResource SecondaryButton}" />
            </Grid>

            <Border Padding="22" BackgroundColor="{DynamicResource PrimaryContainer}" StrokeThickness="0">
                <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="5">
                    <Label Text="{Binding Title}" TextColor="{DynamicResource OnPrimaryContainer}" FontSize="19" FontAttributes="Bold" />
                    <Label Text="{Binding Subtitle}" TextColor="{DynamicResource OnPrimaryContainer}" />
                    <Label Text="{Binding TotalDurationText}" TextColor="{DynamicResource OnPrimaryContainer}" FontSize="28" FontAttributes="Bold" Margin="0,6,0,0" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="18" BindableLayout.ItemsSource="{Binding Bars}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="services:TimeChartBar">
                        <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="12">
                            <Label Text="{Binding Label}" Style="{StaticResource MutedLabel}" VerticalTextAlignment="Center" Margin="0,3,0,0" />
                            <VerticalStackLayout Grid.Column="1" Spacing="7">
                                <Border HeightRequest="28" BackgroundColor="{DynamicResource SurfaceContainerHigh}" StrokeThickness="0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                    <HorizontalStackLayout Spacing="2" BindableLayout.ItemsSource="{Binding Segments}" VerticalOptions="Center" HorizontalOptions="Start">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="services:TimeChartSegment">
                                                <Border WidthRequest="{Binding Width}" HeightRequest="22" BackgroundColor="{Binding Color}" StrokeThickness="0">
                                                    <Border.StrokeShape><RoundRectangle CornerRadius="5" /></Border.StrokeShape>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </HorizontalStackLayout>
                                </Border>
                                <FlexLayout Direction="Row" Wrap="Wrap" BindableLayout.ItemsSource="{Binding Segments}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="services:TimeChartSegment">
                                            <Border Margin="0,0,6,4" Padding="7,3" BackgroundColor="{DynamicResource SurfaceContainer}" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                                <HorizontalStackLayout Spacing="5">
                                                    <BoxView Color="{Binding Color}" WidthRequest="9" HeightRequest="9" CornerRadius="4.5" VerticalOptions="Center" />
                                                    <Label Text="{Binding DisplayText}" FontSize="12" />
                                                </HorizontalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="{Binding DurationText}" FontAttributes="Bold" VerticalTextAlignment="Center" HorizontalTextAlignment="End" Margin="0,3,0,0" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasError}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource Primary}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
